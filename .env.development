# Local development reads the fixtures in fixtures/ instead of the published GitHub branches, so
# the page can be worked on with no network and no publisher running.
#
# They live in fixtures/ rather than public/ on purpose. Anything in public/ is copied into the
# Pages artifact, which would publish a stale status.json at the site's own URL: a file nothing
# reads, that looks authoritative, and that would never update. The Vite dev server serves the
# project root, so these resolve in dev and are simply absent from a production build.
VITE_STATUS_URL=/platform-status/fixtures/status.json
VITE_INCIDENTS_URL=/platform-status/fixtures/incidents.json

# The manual-refresh path too. Left unset, pressing Refresh locally would reach out to real GitHub
# while the rest of the page read fixtures, and spend the API's hourly per-IP budget doing it.
VITE_STATUS_API_URL=/platform-status/fixtures/status.json
VITE_INCIDENTS_API_URL=/platform-status/fixtures/incidents.json
